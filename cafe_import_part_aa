  `idOrderItem` int NOT NULL AUTO_INCREMENT,
  `orderId` int NOT NULL,
  `menuItemId` int NOT NULL,
  `itemSizeId` int DEFAULT NULL,
  `quantity` int NOT NULL DEFAULT '1',
