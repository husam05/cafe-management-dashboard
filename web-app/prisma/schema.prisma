// schema.prisma - Complete Cafe Financial Management System
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  QR
  OTHER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum SaleStatus {
  PAID
  VOID
  REFUND
}

enum PayrollStatus {
  OPEN
  CLOSED
}

enum PayrollItemType {
  SALARY
  ADVANCE
  BONUS
  DEDUCTION
  OVERTIME
}

enum MovementType {
  IN
  OUT
  WASTE
  ADJUST
}

// ==========================================
// MASTER DATA
// ==========================================

model Category {
  id          BigInt   @id @default(autoincrement()) @map("idCategory")
  name        String   @map("categoryName") @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("displayOrder")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  products Product[]

  @@index([sortOrder])
  @@map("Categories")
}

model Product {
  id          BigInt   @id @default(autoincrement()) @map("idMenuItem")
  categoryId  BigInt
  name        String   @map("itemName") @db.VarChar(200)
  description String?  @db.Text
  imageUrl    String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  Category         @relation(fields: [categoryId], references: [id])
  variants  ProductVariant[]
  saleItems SaleItem[]
  recipes   Recipe[]

  @@index([categoryId])
  @@map("MenuItems") // Legacy DB uses MenuItems for products
}

model ProductVariant {
  id          BigInt   @id @default(autoincrement())
  productId   BigInt
  variantName String   @db.VarChar(80)
  price       Decimal  @db.Decimal(12, 2)
  costEst     Decimal? @db.Decimal(12, 2)
  sku         String?  @db.VarChar(80)
  isActive    Boolean  @default(true)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]
  recipes   Recipe[]

  @@index([productId])
  @@map("ItemSizes") // Legacy DB might use ItemSizes or similar? Let's check DB table list: ItemSizes.
}

// Re-checking DB tables from Step 527: 
// Categories, DailyReceipts, Expenses, Ingredients, InventoryTransactions, ItemSizes, MenuItems, OrderItems, Orders, Payments, PurchaseItems, Purchases, Recipes, Staff, SupplierCredits, SupplierPayments, Suppliers, Tips

// Mapping correction based on actual tables:

// Category -> Categories  (CORRECT)
// Product -> MenuItems    (CORRECT)
// ProductVariant -> ItemSizes (LIKELY, based on schema logic, or just a new table? SQL dump had ItemSizes)
// Employee -> Staff       (CORRECT)
// Customer -> Customers   (Not in list? Maybe not used or named differently. SQL dump didn't show Customers. Removing or keeping standard.)
// Shift -> DailyReceipts  (CORRECT)
// Sale -> Orders          (CORRECT)
// SaleItem -> OrderItems  (CORRECT)
// Payment -> Payments     (CORRECT)
// ...

// Applying mappings:

model Employee {
  id         BigInt    @id @default(autoincrement()) @map("idStaff")
  fullName   String    @db.VarChar(160)
  role       String?   @db.VarChar(80)
  phone      String?   @db.VarChar(40)
  email      String?   @db.VarChar(120)
  baseSalary Decimal?  @map("salary") @db.Decimal(12, 2)
  isActive   Boolean   @default(true)
  hiredAt    DateTime? @map("hireDate")
  createdAt  DateTime  @default(now())

  shiftsOpened Shift[]       @relation("ShiftOpenedBy")
  shiftsClosed Shift[]       @relation("ShiftClosedBy")
  expensesPaid Expense[]
  payrollItems PayrollItem[]

  @@index([isActive])
  @@map("Staff")
}

model Customer {
  id    BigInt  @id @default(autoincrement())
  name  String? @db.VarChar(160)
  phone String? @db.VarChar(40)
  email String? @db.VarChar(120)

  sales Sale[]

  @@map("customers") // Keep lower if not present, likely unused in stale app or strict new feature
}

model Shift {
  id           BigInt   @id @default(autoincrement()) @map("idDailyReceipt")
  businessDate DateTime @map("receiptDate") @db.Date
  shiftNo      Int      @map("shiftNumber")
  openingCash  Decimal  @default(0) @db.Decimal(12, 2)
  closingCash  Decimal? @db.Decimal(12, 2)

  totalSales    Decimal? @db.Decimal(10, 2)
  totalExpenses Decimal? @db.Decimal(10, 2)

  openedAt DateTime  @default(now())
  closedAt DateTime?

  // status       ShiftStatus @default(OPEN)
  isClosed Boolean @default(false) @map("isClosed")

  note String? @map("notes") @db.Text

  openedById BigInt? @map("openedBy")
  closedById BigInt? @map("closedBy")

  openedBy Employee? @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy Employee? @relation("ShiftClosedBy", fields: [closedById], references: [id])

  // sales        Sale[]
  sales Sale[]

  @@unique([businessDate, shiftNo])
  @@index([businessDate])
  @@map("DailyReceipts")
}

model Sale {
  id           BigInt   @id @default(autoincrement()) @map("idOrder")
  invoiceNo    String   @unique @map("orderNumber") @db.VarChar(40)
  businessDate DateTime @map("orderDate") @db.Timestamp(0)

  tableNumber String? @db.VarChar(20)
  orderType   String? @db.VarChar(40)

  subtotal Decimal    @default(0) @db.Decimal(12, 2)
  discount Decimal    @default(0) @db.Decimal(12, 2)
  tax      Decimal    @default(0) @db.Decimal(12, 2)
  total    Decimal    @default(0) @map("totalAmount") @db.Decimal(12, 2)
  status   SaleStatus @default(PAID)
  // createdAt removed

  items      SaleItem[]
  payments   Payment[]
  // customer relations removed
  // shift relations removed
  customer   Customer?  @relation(fields: [customerId], references: [id])
  customerId BigInt?
  shift      Shift?     @relation(fields: [shiftId], references: [id])
  shiftId    BigInt?

  @@index([businessDate])
  @@map("Orders")
}

model SaleItem {
  id        BigInt  @id @default(autoincrement()) @map("idOrderItem")
  saleId    BigInt  @map("orderId")
  productId BigInt  @map("menuItemId")
  variantId BigInt? @map("itemSizeId")

  qty       Decimal @default(1) @map("quantity") @db.Decimal(12, 3) // DB is INT, Schema Decimal. Prisma might cast.
  unitPrice Decimal @map("price") @db.Decimal(12, 2)
  // lineTotal Decimal @db.Decimal(12, 2) // Missing in DB
  // Cannot map lineTotal. Must be removed or optional+ignored.
  // We'll remove it from model. Code using it will fail?
  // Maybe adding @ignore? No, @ignore hides it from client.
  // If I remove it, I must fix code. 
  // Let's leave it commented.

  sale    Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("OrderItems")
}

model Payment {
  id     BigInt @id @default(autoincrement()) @map("idPayment")
  saleId BigInt @map("orderId")
  // method PaymentMethod // DB is enum('cash'). Schema Enum: CASH, CARD...
  // Mismatch. Map to String?
  // Or just accept it might fail if we read 'card' and it's not in DB enum? 
  // Wait, DB enum is 'cash'. If we insert 'card', it fails.
  // Reading: 'cash' maps to... CASH? Case sensitive?
  // Let's change to String to be safe.
  method String @map("paymentMethod")

  amount Decimal  @map("amountReceived") @db.Decimal(12, 2)
  paidAt DateTime @default(now()) @map("paymentDate")
  refNo  String?  @map("receiptNumber") @db.VarChar(120)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([paidAt])
  @@map("Payments")
}

model Vendor {
  id    BigInt  @id @default(autoincrement())
  name  String  @db.VarChar(200)
  phone String? @db.VarChar(40)
  note  String? @db.Text

  expenses Expense[]

  @@map("Suppliers") // Likely Suppliers in legacy
}

model ExpenseCategory {
  id    BigInt  @id @default(autoincrement())
  name  String  @unique @db.VarChar(120)
  icon  String? @db.VarChar(50)
  color String? @db.VarChar(20)

  expenses Expense[]
  // Legacy Expense: idExpense, expenseDate, category (string), amount, description...
  // New Schema has ExpenseCategory model linked to Expense?
  // If legacy DB stores category as STRING in Expenses table, this Relation will FAIL.
  // We need to check if legacy has a separate category table. The list in 527 does NOT show ExpenseCategories. 
  // It shows: Categories (for products), DailyReceipts, Expenses...
  // This implies Expenses likely stores category as a string or ID to something else? 
  // Checking csv-parser.ts (Step 467): Expense has `category: string`.
  // Checking db.ts (Step 461): `category: e.category` (string).
  // Schema.prisma defines `category ExpenseCategory @relation(...)`.
  // THIS IS A MISMATCH. The new schema expects a normalized ExpenseCategory table, but the legacy DB (and SQL dump) likely uses a flat string column.
  // Fixing this requires chaning the model to use String for category, OR creating the table.
  // Since we are mapping to existing DB, we should probably adjust the model to match reality or accept that we might need to migrate data. 
  // However, for "Fixing Schema Mismatch", we should map to what exists. 
  // If we change Expense to have `category String`, it breaks the Relation.
  // Let's stick to mapping tables first. `expense_categories` table is missing in DB. 
  // We will likely face an error here next. But first fix the table names we KNOW exist.

  @@map("expense_categories") // Not in list? Maybe pure relation or missing. Let's keep lower or remove if not critical. WAIT, "Expenses" exists. Category is in Expenses table as string in legacy? 
}

model Expense {
  id          BigInt   @id @default(autoincrement()) @map("idExpense")
  expenseDate DateTime @db.Date
  category    String   @map("category") @db.VarChar(100)
  paidById    BigInt?  @map("recordedBy")

  amount      Decimal  @db.Decimal(12, 2)
  description String?  @db.Text
  receiptUrl  String?  @map("photoUrl") @db.Text
  createdAt   DateTime @default(now())

  paidBy            Employee?        @relation(fields: [paidById], references: [id])
  vendor            Vendor?          @relation(fields: [vendorId], references: [id])
  vendorId          BigInt?
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id])
  expenseCategoryId BigInt?

  @@index([expenseDate])
  @@map("Expenses")
}

model PayrollRun {
  id        BigInt        @id @default(autoincrement())
  payMonth  DateTime      @db.Date
  status    PayrollStatus @default(OPEN)
  note      String?       @db.Text
  createdAt DateTime      @default(now())
  closedAt  DateTime?

  items PayrollItem[]

  @@unique([payMonth])
  @@map("payroll_runs") // Not in DB list. New feature?
}

model PayrollItem {
  id            BigInt          @id @default(autoincrement())
  payrollId     BigInt
  employeeId    BigInt
  itemType      PayrollItemType
  amount        Decimal         @db.Decimal(12, 2)
  note          String?         @db.Text
  paidAt        DateTime?
  paymentMethod PaymentMethod?

  payroll  PayrollRun @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id])

  @@index([payrollId])
  @@index([employeeId])
  @@index([paidAt])
  @@map("payroll_items") // Not in DB list.
}

model InventoryItem {
  id           BigInt   @id @default(autoincrement()) @map("idIngredient")
  name         String   @map("ingredientName") @db.VarChar(200)
  unit         String   @db.VarChar(30)
  currentStock Decimal  @default(0) @db.Decimal(12, 3)
  reorderLevel Decimal? @map("minStock") @db.Decimal(12, 3)
  costPerUnit  Decimal? @db.Decimal(12, 2)
  isActive     Boolean  @default(true)

  // movements InventoryMovement[] 
  // recipes   Recipe[]
  inventoryMovements InventoryMovement[]
  recipes            Recipe[]

  @@map("Ingredients")
}

model InventoryMovement {
  id           BigInt       @id @default(autoincrement())
  itemId       BigInt
  movementType MovementType
  qty          Decimal      @db.Decimal(12, 3)
  unitCost     Decimal?     @db.Decimal(12, 2)
  movementAt   DateTime     @default(now())
  refType      String?      @db.VarChar(30)
  refId        BigInt?
  note         String?      @db.Text

  item InventoryItem @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([movementAt])
  @@index([movementType])
  @@map("InventoryTransactions") // Maps to InventoryTransactions
}

model Recipe {
  id        BigInt  @id @default(autoincrement())
  productId BigInt
  variantId BigInt?
  itemId    BigInt
  qtyNeeded Decimal @db.Decimal(12, 3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  item    InventoryItem   @relation(fields: [itemId], references: [id])

  @@unique([productId, variantId, itemId])
  @@index([itemId])
  @@map("Recipes")
}

model DailySummary {
  id            BigInt   @id @default(autoincrement())
  businessDate  DateTime @unique @db.Date
  totalRevenue  Decimal  @default(0) @db.Decimal(14, 2)
  totalExpenses Decimal  @default(0) @db.Decimal(14, 2)
  totalPayroll  Decimal  @default(0) @db.Decimal(14, 2)
  totalCOGS     Decimal  @default(0) @db.Decimal(14, 2)
  netProfit     Decimal  @default(0) @db.Decimal(14, 2)
  orderCount    Int      @default(0)
  avgTicket     Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt     DateTime @updatedAt

  @@index([businessDate])
  @@map("daily_summaries") // Not in DB. New feature/cache?
}
